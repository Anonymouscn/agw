diff --git a/sound/shairport-sync/patches/010-ffmpeg-codec-config.patch b/sound/shairport-sync/patches/010-ffmpeg-codec-config.patch
--- a/sound/shairport-sync/patches/010-ffmpeg-codec-config.patch
+++ b/sound/shairport-sync/patches/010-ffmpeg-codec-config.patch
@@ -0,0 +1,36 @@
+Subject: [PATCH] shairport-sync: query FFmpeg decoder sample formats
+
+FFmpeg 9 removes AVCodec.sample_fmts; query supported decoder formats.
+
+--- a/shairport.c
++++ b/shairport.c
+@@ -160,6 +160,21 @@
+   int has_capability = 0;
+   const AVCodec *codec = avcodec_find_decoder(AV_CODEC_ID_AAC);
+   if (codec != NULL) {
++#if LIBAVCODEC_VERSION_MAJOR >= 63
++    const void *configs = NULL;
++    int count = 0;
++    if (avcodec_get_supported_config(NULL, codec, AV_CODEC_CONFIG_SAMPLE_FORMAT,
++                                     0, &configs, &count) >= 0) {
++      if (configs == NULL) {
++        has_capability = 1; // NULL means all formats are supported.
++      } else {
++        const enum AVSampleFormat *p = configs;
++        for (int i = 0; i < count; i++)
++          if (p[i] == AV_SAMPLE_FMT_FLTP)
++            has_capability = 1;
++      }
++    }
++#else
+     const enum AVSampleFormat *p = codec->sample_fmts;
+     if (p != NULL) {
+       while ((has_capability == 0) && (*p != AV_SAMPLE_FMT_NONE)) {
+@@ -168,6 +183,7 @@
+         p++;
+       }
+     }
++#endif
+   }
+   return has_capability;
+ }
