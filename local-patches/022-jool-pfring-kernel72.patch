diff --git a/net/jool/patches/110-fold-percpu-stats-locally.patch b/net/jool/patches/110-fold-percpu-stats-locally.patch
new file mode 100644
index 0000000..ef053a2
--- /dev/null
+++ b/net/jool/patches/110-fold-percpu-stats-locally.patch
@@ -0,0 +1,23 @@
+From: AGW regression fixes <noreply@local>
+Subject: [PATCH] jool: fold per-cpu counters without non-exported kernel helper
+
+--- a/src/mod/common/stats.c
++++ b/src/mod/common/stats.c
+@@ -79,8 +79,15 @@
+ 	if (!result)
+ 		return NULL;
+ 
+-	for (i = 0; i < JSTAT_COUNT; i++)
+-		result[i] = snmp_fold_field(stats->mib, i);
++	for (i = 0; i < JSTAT_COUNT; i++) {
++		unsigned long sum = 0;
++		int cpu;
++
++		/* snmp_fold_field() is internal to the kernel in Linux 7.2. */
++		for_each_possible_cpu(cpu)
++			sum += snmp_get_cpu_field(stats->mib, cpu, i);
++		result[i] = sum;
++	}
+ 
+ 	return result;
+ }
