Subject: [PATCH] rtl8812au: adapt to cfg80211 APIs from backports 7.2

OpenWrt uses backports 7.2 even on Linux 6.12. Convert key and station
callbacks and notifications to wireless_dev, preserving the net_device
used internally. Accept the new remain-on-channel receive address
argument and reject address filtering, which this driver does not advertise.

--- a/os_dep/linux/ioctl_cfg80211.c
+++ b/os_dep/linux/ioctl_cfg80211.c
@@ -1387,7 +1387,7 @@
 	return ret;
 }
 
-static int cfg80211_rtw_add_key(struct wiphy *wiphy, struct net_device *ndev,
+static int cfg80211_rtw_add_key(struct wiphy *wiphy, struct wireless_dev *wdev,
 #if (LINUX_VERSION_CODE >= KERNEL_VERSION(2,6,37)) || defined(COMPAT_KERNEL_RELEASE)
                                 int link_id,
                                 u8 key_index, bool pairwise, const u8 *mac_addr,
@@ -1396,6 +1396,7 @@
 #endif	// (LINUX_VERSION_CODE >= KERNEL_VERSION(2,6,37))
                                 struct key_params *params)
 {
+	struct net_device *ndev = wdev_to_ndev(wdev);
 	char *alg_name;
 	u32 param_len;
 	struct ieee_param *param = NULL;
@@ -1528,7 +1529,7 @@
 
 }
 
